APP_ENV=production
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32
INTERNAL_AGENT_SECRET=change-me-agent-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
MAX_SESSIONS_GLOBAL=5
MAX_SESSIONS_PER_USER=2
SESSION_IDLE_TIMEOUT=30m
SESSION_MAX_DURATION=2h
BROWSER_IMAGE=browser-gateway/browser-engine:local
BROWSER_IMAGE_FIREFOX=browser-gateway/browser-engine-firefox:local
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
