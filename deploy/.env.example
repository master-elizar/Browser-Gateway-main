# Copy to deploy/.env (install.sh generates this). Do not commit real secrets.
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
DOCKER_GID=999
# Address(es) the VIEWER'S BROWSER connects to for WebRTC, NOT an address inside Docker --
# "localhost" here only ever works for a browser running on this same host. coturn listens on
# every interface of this host (network_mode: host below), so a single instance can usually
# serve every access path at once -- just list one turn:host:3478 entry per path client
# devices will actually be on, comma-separated; WebRTC tries all of them and uses whichever
# one connects:
#   TURN_URLS=turn:192.168.1.4:3478,turn:100.x.x.x:3478,turn:your-public-ip-or-domain:3478
#             ^ this host's real LAN IP   ^ this host's Tailscale IP, if installed   ^ public
# The public entry additionally needs UDP+TCP 3478 (and coturn's relay port range) forwarded
# on your router to this host, and coturn told its public IP via --external-ip in
# docker-compose.yml's coturn service (commented out there by default) -- otherwise coturn
# reports its private LAN address to public clients, who can't route to it.
TURN_URLS=turn:localhost:3478
GF_SERVER_ROOT_URL=http://localhost:3000
